/*<simulation_settings>
<ftestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off vwf_vga_timing -c vwf_vga_timing --vector_source="D:/code/2026/labdigiporg/digiproject2006/waveforms/vga_timing/tc17_vga_frame.vwf" --testbench_file="D:/code/2026/labdigiporg/digiproject2006/waveforms/vga_timing/simulation/qsim/tc17_vga_frame.vwf.vht"</ftestbench_cmd>
<ttestbench_cmd>quartus_eda --gen_testbench --tool=modelsim_oem --format=vhdl --write_settings_files=off vwf_vga_timing -c vwf_vga_timing --vector_source="D:/code/2026/labdigiporg/digiproject2006/waveforms/vga_timing/tc17_vga_frame.vwf" --testbench_file="D:/code/2026/labdigiporg/digiproject2006/waveforms/vga_timing/simulation/qsim/tc17_vga_frame.vwf.vht"</ttestbench_cmd>
<fnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=on --flatten_buses=off --tool=modelsim_oem --format=vhdl --output_directory="D:/code/2026/labdigiporg/digiproject2006/waveforms/vga_timing/simulation/qsim/" vwf_vga_timing -c vwf_vga_timing</fnetlist_cmd>
<tnetlist_cmd>quartus_eda --write_settings_files=off --simulation --functional=off --flatten_buses=off --timescale=1ps --tool=modelsim_oem --format=vhdl --output_directory="D:/code/2026/labdigiporg/digiproject2006/waveforms/vga_timing/simulation/qsim/" vwf_vga_timing -c vwf_vga_timing</tnetlist_cmd>
<modelsim_script>onerror {exit -code 1}
vlib work
vcom -work work vwf_vga_timing.vho
vcom -work work tc17_vga_frame.vwf.vht
vsim -voptargs=+acc -c -t 1ps -L fiftyfivenm -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.vwf_vga_timing_vhd_vec_tst
vcd file -direction vwf_vga_timing.msim.vcd
vcd add -internal vwf_vga_timing_vhd_vec_tst/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script>
<modelsim_script_timing>onerror {exit -code 1}
vlib work
vcom -work work vwf_vga_timing.vho
vcom -work work tc17_vga_frame.vwf.vht
vsim -voptargs=+acc -c -t 1ps -sdfmax vwf_vga_timing_vhd_vec_tst/i1=vwf_vga_timing_vhd.sdo -L fiftyfivenm -L altera -L altera_mf -L 220model -L sgate -L altera_lnsim work.vwf_vga_timing_vhd_vec_tst
vcd file -direction vwf_vga_timing.msim.vcd
vcd add -internal vwf_vga_timing_vhd_vec_tst/*
proc simTimestamp {} {
    echo "Simulation time: $::now ps"
    if { [string equal running [runStatus]] } {
        after 2500 simTimestamp
    }
}
after 2500 simTimestamp
run -all
quit -f
</modelsim_script_timing>
<hdl_lang>vhdl</hdl_lang>
</simulation_settings>*/
